{
  "name": "@lunatest/e2e-tests",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:smoke",
    "test:smoke": "vitest run mcp-flow.smoke.test.ts playwright-routing.smoke.test.ts runner-integration.smoke.test.ts cli-gen.smoke.test.ts protocol-wallet-completion.smoke.test.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:extended": "vitest run"
  },
  "dependencies": {
    "@lunatest/cli": "workspace:*",
    "@lunatest/core": "workspace:*",
    "@lunatest/mcp": "workspace:*",
    "@lunatest/playwright-plugin": "workspace:*",
    "@lunatest/runtime-intercept": "workspace:*",
    "@lunatest/vitest-plugin": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.2",
    "vitest": "4.1.6"
  }
}
